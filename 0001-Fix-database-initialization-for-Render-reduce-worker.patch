From 9d76882201be8110f42c0eb080b43ba8e22df778 Mon Sep 17 00:00:00 2001
From: Yura <kisa134@github.com>
Date: Fri, 9 Jan 2026 10:07:24 +0000
Subject: [PATCH 1/2] Fix database initialization for Render - reduce workers
 and add timeout

---
 backend/app.py | 14 +++++++++++---
 render.yaml    |  2 +-
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/backend/app.py b/backend/app.py
index e447fe2..707838c 100644
--- a/backend/app.py
+++ b/backend/app.py
@@ -337,10 +337,18 @@ def get_global_stats():
         'total_users': total_users
     })
 
-# Initialize database
+# Initialize database (only create tables if they don't exist)
+import os
 with app.app_context():
-    db.create_all()
-    print("Database initialized!")
+    # Check if database file exists, if not - create tables
+    db_path = app.config['SQLALCHEMY_DATABASE_URI'].replace('sqlite:///', '')
+    if not os.path.exists(db_path):
+        db.create_all()
+        print("Database initialized!")
+    else:
+        # Just ensure connection works
+        db.engine.connect()
+        print("Database connected!")
 
 if __name__ == '__main__':
     app.run(debug=True, host='0.0.0.0', port=5000)
diff --git a/render.yaml b/render.yaml
index 908fa00..5d16cd6 100644
--- a/render.yaml
+++ b/render.yaml
@@ -5,7 +5,7 @@ services:
     runtime: python
     plan: free
     buildCommand: "pip install -r backend/requirements.txt"
-    startCommand: "cd backend && gunicorn -w 4 -b 0.0.0.0:$PORT app:app"
+    startCommand: "cd backend && gunicorn -w 1 -b 0.0.0.0:$PORT --timeout 120 app:app"
     envVars:
       - key: PYTHON_VERSION
         value: 3.12.0
-- 
